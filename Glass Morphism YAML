"data:image/svg+xml," & EncodeUrl("
<svg xmlns='http://www.w3.org/2000/svg' style='font-family: sans-serif; font-weight: 300; background-size: 100%; width: " & Self.Width & "px; height: " & Self.Height - 1 & "px; margin:0; padding:0;'>
<style>
<![CDATA[

.glassContainer {
    position: fixed; 
    display: flex; 
    width: 100%; 
    height: 100%; 
    border-radius: 30px; 
    align-items: center; 
    justify-content: center;
}

.glassContainer::before {
    position: absolute; 
    inset: 0; 
    border-radius: 30px; 
    box-shadow: inset 2px 2px 0px -2px rgba(255, 255, 255, 0.7), inset 0 -1px 5px 4px rgba(255, 255, 255, 0.7);
    content: '';
}

.glassContainer::after {
    position: absolute; 
    inset: 0; 
    border-radius: 30px; 
    backdrop-filter: blur(5px);

    filter: url(#container-glass);
    z-index: -1; 
    content: ''; 
    overflow: hidden;
    
}

.foreignObjectClass { 
    height: 92%;
    width: 92%;
    border-radius: 30px;
    background-color: rgba(255,255,255,.4);
    box-shadow: 0px 2px 6px 1px rgba(0, 0, 0, 0.2);
    }
]]>
</style>
<defs>
    <filter id='container-glass' x='0' y='0' width='100%' height='100%'>
        <feTurbulence type='fractalNoise' baseFrequency='1.08 1.08' numOctaves='1' seed='65' result='noise' />
        <feGaussianBlur in='noise' stdDeviation='0.902' result='blur' />
        <feDisplacementMap in='SourceGraphic' in2='blur' scale='2' xChannelSelector='B' yChannelSelector='G' />
    </filter>
</defs>
<foreignObject x='4%' y='4%' class='foreignObjectClass'>

    <div xmlns='http://www.w3.org/1999/xhtml' class='glassContainer' x='0' y='0'></div>

</foreignObject>
</svg>
")
